{
  "name": "ai-workbench",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @aiwb/shared build && pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @aiwb/server dev",
    "dev:web": "pnpm --filter @aiwb/web dev",
    "cli": "node apps/cli/dist/cli.js",
    "dev:cli": "pnpm --filter @aiwb/cli dev",
    "build": "pnpm -r run build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0"
}
