# ai-workbench 全局环境配置模板（网站级 / 跨服务共享）
# 复制为 .env 并按实际值修改（.env 不入库）。
#
# 归属说明：本文件配置属于「整个网站」的入口级配置，不归属于任何单一服务。
# 各服务（如 services/minio）通过引用本文件读取共享凭据，不在服务内部重复定义。

# 网站管理员账号（同时作为 MinIO root 用户，单一来源）
# 改这里一处，网站管理员与对象存储 root 同步生效。
# 注意：MinIO 要求密码至少 8 位。
ADMIN_USER=admin
ADMIN_PASS=admin123

# 站点级发信（注册验证码等系统邮件）
# 不配置时验证码只打印到服务端日志，并在注册页回显（仅供本地开发）
# SMTP_USER 通常就是发件邮箱，SMTP_PASS 是邮箱授权码 / 应用专用密码
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 登录态：refresh token 存在 httpOnly Cookie 里（accessToken 只在内存，15 分钟过期）
# 生产走 HTTPS 时置 true，本地 http 调试必须 false，否则浏览器不会保存 Cookie
COOKIE_SECURE=false

# 邮件增量同步轮询间隔（毫秒）：服务端按「上次同步时间 - 1 天」增量拉取
# 60 秒即准实时；设为 0 关闭后台同步（只保留手动/打开面板时同步）
MAIL_SYNC_INTERVAL_MS=60000
