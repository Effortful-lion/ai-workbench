{
  "name": "@aiwb/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:lightrag": "KB_PROVIDER=lightrag LIGHTRAG_URL=http://localhost:9621 LIGHTRAG_API_KEY=$(grep '^LIGHTRAG_API_KEY=' ../../services/lightrag/.env | cut -d= -f2-) ADMIN_USER=$(grep '^ADMIN_USER=' ../../.env | cut -d= -f2-) ADMIN_PASS=$(grep '^ADMIN_PASS=' ../../.env | cut -d= -f2-) MINIO_ACCESS_KEY=$(grep '^ADMIN_USER=' ../../.env | cut -d= -f2-) MINIO_SECRET_KEY=$(grep '^ADMIN_PASS=' ../../.env | cut -d= -f2-) node --enable-source-maps dist/main",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aiwb/shared": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/websockets": "^12.3.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "minio": "^8.0.7",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
