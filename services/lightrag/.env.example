# LightRAG PoC 独立服务 —— 环境配置模板
# 复制为 .env 并填入真实值（.env 不入库）。
# 本目录与 ai-workbench 主仓代码零耦合：只依赖 env 注入，可整体迁移到任何项目。

### Server
PORT=9621
WEBUI_TITLE=aiwb-lightrag-poc
SUMMARY_LANGUAGE=Chinese
# 多项目/多租户隔离：与 siftops 的 system_id 一一对应，未来每项目一个 workspace
WORKSPACE=aiwb
# API 访问令牌：调用方需在 header 带 X-API-Key
LIGHTRAG_API_KEY=change-me-local-token

# 文档处理：固定长度切分，最小依赖（lite 镜像无原生解析器模型）
LIGHTRAG_PARSER=*:legacy-F
VLM_PROCESS_ENABLE=false

### LLM（云端，OpenAI 兼容协议；当前用 deepseek-flash）
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.deepseek.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=deepseek-flash

### Embedding（本地 ollama，零 key；换云端时只改这 4 行并重建索引）
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://ollama:11434
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192

### 存储：默认本地文件（JsonKV + NanoVectorDB + NetworkX），PoC 够用
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
